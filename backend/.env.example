# Database — SQLite for development, PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./pharmasee.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/pharmasee

# App
DEBUG=true
CACHE_TTL_SECONDS=86400

# CORS — add the frontend URL
ALLOWED_ORIGINS=["http://localhost:3000"]

# Admin token for POST /fda/sync, /sec/sync, /sec/extract (header X-Admin-Token).
# Leave empty to disable these endpoints. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# SEC EDGAR — sent in the User-Agent of every request, as SEC requires
SEC_CONTACT_EMAIL=you@example.com

# Google Gemini — catalyst extraction from SEC filings (free tier key from aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite